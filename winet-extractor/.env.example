# One or more WiNet hosts, comma separated. All share the credentials below.
WINET_HOST=
MQTT_URL=
# Uncomment only settings you want to override; omitted settings retain JSON/defaults.
# MQTT_PREFIX=homeassistant
# WINET_USER=
# WINET_PASS=
# POLL_INTERVAL=10
# ANALYTICS=true
# SSL=false
# Publish a "WiNet Site" device summing all inverters (needs 2+ inverters)
# SITE_TOTALS=true
# Optional: base64 of one trusted PEM certificate enables certificate verification.
# WINET_TLS_CA_CERT_BASE64=
# Optional DNS name from that certificate, when connecting by IP.
# WINET_TLS_SERVER_NAME=
